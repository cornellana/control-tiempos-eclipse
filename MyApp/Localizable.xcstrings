    "Shows all scheduled cues in order. Auto-scrolls to keep the next upcoming event centred on screen with its countdown in large digits." : {
      "comment" : "Guided tour detail for announcement list in step 5",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra tots els avisos programats en ordre. Desplaçament automàtic per mantenir el proper event centrat a la pantalla, amb el seu compte enrere en dígits grans."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra todos los avisos programados en orden. Desplazamiento automático para mantener el próximo evento centrado en pantalla, con su cuenta atrás en dígitos grandes."
          }
        }
      }
    },
    "Shows your observation point with a pin. Confirms visually that the coordinates correspond to your actual site." : {
      "comment" : "Guided tour detail for the verification map in step 3",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra el teu punt d'observació amb un marcador. Confirma visualment que les coordenades corresponen al teu lloc real."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra tu punto de observación con un marcador. Confirma visualmente que las coordenadas corresponden a tu sitio real."
          }
        }
      }
    },
    "SIMULATION" : {
      "comment" : "Eclipse kind badge",
      "localizations" : {
