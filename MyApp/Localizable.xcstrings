        }
      }
    },
    "Selects the eclipse or rehearsal date. The app pre-fills the next visible eclipse at your location; change it to any date for a rehearsal." : {
      "comment" : "Guided tour detail for the date picker in step 2",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona la data de l'eclipsi o de l'assaig. L'app omple automàticament el proper eclipsi visible a la teva ubicació; canvia-la per practicar amb una altra data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona la fecha del eclipse o del ensayo. La app rellena automáticamente el próximo eclipse visible en tu ubicación; cámbiala para practicar con otra fecha."
          }
        }
      }
    },
    "Sends the event list to any AirPrint-compatible printer — a useful paper backup during the event." : {
      "comment" : "Guided tour detail for Print button in step 4",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia la llista d'esdeveniments a qualsevol impressora AirPrint — una còpia de seguretat en paper útil durant l'event."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía la lista de eventos a cualquier impresora AirPrint — una copia de seguridad en papel útil durante el evento."
          }
        }
      }
    },
    "Sets the date to today, useful when running a full rehearsal without a real eclipse." : {
      "comment" : "Guided tour detail for the Today button in step 2",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa la data al dia d'avui, útil quan es fa un assaig complet sense eclipsi real."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija la fecha al día de hoy, útil cuando se hace un ensayo completo sin eclipse real."
          }
        }
      }
    },
    "Settings" : {
      "comment" : "Settings toolbar button and sheet title",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
